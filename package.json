  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite --port=2500 --strictPort --host=127.0.0.1",
    "build": "vite build",
    "dev:synthetic": "vite --mode synthetic --port=2517 --strictPort --host=127.0.0.1",
    "dev:knowledge-lab": "vite --port=2727 --strictPort --host=127.0.0.1",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/engine/*.test.ts src/history/*.test.ts src/knowledge/*.test.ts src/components/*.test.tsx",
    "test:ui": "playwright test",
    "test:knowledge-lab": "tsx --test tests/knowledge-lab/*.test.ts tests/knowledge-lab/*.test.tsx"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
